{
  "name": "@bandage/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "ts-node scripts/initDb.ts",
    "create-user": "ts-node scripts/createUser.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.legacy.json --noEmit"
  },
  "dependencies": {
    "express": "^4.17.2",
    "dotenv": "^16.0.0",
    "mysql2": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.29.1",
    "@bandage/shared": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^18.13.0",
    "typescript": "^4.9.5",
    "ts-node": "^10.5.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^8.5.8",
    "tsx": "^3.12.3"
  },
  "engines": {
    "node": ">=16"
  }
}
